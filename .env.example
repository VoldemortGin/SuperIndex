# ── PageIndex × AIA annual reports — test configuration ──────────────────
# Copy this file to `.env` and fill in ONE provider's key.
#   cp .env.example .env
#
# PageIndex routes model names through LiteLLM, so any LiteLLM-supported
# provider works. Two separate roles are configured:
#   * index model — builds the tree + node summaries (a cheap model is fine)
#   * chat model  — answers questions over the tree (use a strong model)

# ── Option A: OpenAI (default) ────────────────────────────────────────────
OPENAI_API_KEY=sk-...
PAGEINDEX_INDEX_MODEL=gpt-5-mini
PAGEINDEX_CHAT_MODEL=gpt-5

# ── Option B: Anthropic ───────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# PAGEINDEX_INDEX_MODEL=anthropic/claude-haiku-4-5
# PAGEINDEX_CHAT_MODEL=anthropic/claude-sonnet-4-5

# ── Option C: DeepSeek ────────────────────────────────────────────────────
# DEEPSEEK_API_KEY=sk-...
# PAGEINDEX_INDEX_MODEL=deepseek/deepseek-chat
# PAGEINDEX_CHAT_MODEL=deepseek/deepseek-reasoner
# PAGEINDEX_BASE_URL=https://api.deepseek.com

# ── Option D: any other OpenAI-compatible gateway (Qwen, vLLM, proxy) ─────
# PAGEINDEX_BASE_URL=https://your-gateway.example.com/v1
# PAGEINDEX_API_KEY_OVERRIDE=your-gateway-key
# PAGEINDEX_INDEX_MODEL=openai/your-model-name
# PAGEINDEX_CHAT_MODEL=openai/your-model-name

# ── Latency knobs ─────────────────────────────────────────────────────────
# Reasoning effort for the chat model. Measured on this corpus: "low" cut a
# deep question from 10.3s to 5.8s (-44%) and output tokens by 62%, with the
# answer unchanged. Leave unset to use the default ("low"); set it to an
# empty value to send nothing and get the model's own default back.
# PAGEINDEX_REASONING_EFFORT=low


# ══════════════════════════════════════════════════════════════════════════
# Azure AI Document Intelligence — optional PDF → Markdown extractor
# ══════════════════════════════════════════════════════════════════════════
#
# Only needed if you want to use `scripts/06_azure_extract.py` to turn PDFs
# into Markdown before indexing. The default path reads the PDF's own text
# layer with PyPDF2, which is free but:
#   * mangles tables — a bar-chart page comes out as `175230`, two numbers
#     fused, with the label-to-value association destroyed
#   * refuses scanned / image-only PDFs outright (no text layer, no OCR)
#
# Azure's layout model fixes both: tables come back as real Markdown tables,
# and image-only pages are OCR'd. We also inject `<!-- page: N -->` markers
# so page-level citations survive into the Markdown.
#
# Where to get these values:
#   1. Azure Portal → create a "Document Intelligence" resource
#   2. Keys and Endpoint → copy the endpoint and KEY 1
#   3. Free tier (F0) is fine for testing but throttles hard — keep
#      --workers at 2 and use --pages for smoke tests
#
# AZURE_DI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
# AZURE_DI_KEY=<your-key-1>
#
# ── Model ────────────────────────────────────────────────────────────────
# prebuilt-layout   tables + headings + structure   ← what you want for reports
# prebuilt-read     text only, cheapest
# prebuilt-document text + key/value pairs
# AZURE_DI_MODEL=prebuilt-layout
#
# ── Output format ────────────────────────────────────────────────────────
# markdown  headings and tables preserved as Markdown   ← required by nav.build
# text      flat plain text
# AZURE_DI_OUTPUT_FORMAT=markdown
#
# ── Optional tuning ──────────────────────────────────────────────────────
# Pin the API version if you need reproducible output.
# AZURE_DI_API_VERSION=2024-11-30
#
# unicodeCodePoint keeps character offsets aligned with Python string indices,
# which is what the page-marker injection relies on. Don't change it unless
# you also change the offset handling in extractors/azure_di.py.
# AZURE_DI_STRING_INDEX_TYPE=unicodeCodePoint
#
# Extra analysis features. `formulas` is useful because ratio and per-share
# computations appear as inline math in some filings. Others available:
# ocrHighResolution, languages, barcodes, keyValuePairs, styleFont.
# AZURE_DI_FEATURES=formulas
#
# Locale hint for OCR. Leave empty to let Azure auto-detect.
# AZURE_DI_LOCALE=en-US
#
# Polling. The analyze call is asynchronous: it returns 202 + an
# Operation-Location URL that we poll until status is "succeeded".
# AZURE_DI_POLL_INTERVAL=2
# AZURE_DI_POLL_TIMEOUT=900



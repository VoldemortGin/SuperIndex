# ── PageIndex × AIA annual reports — test configuration ──────────────────
# Copy this file to `.env` and keep ONE provider block active.
#   cp .env.example .env
# A packaged superindex reads `.env` from the working directory, then from
# the folder holding the executable.
#
# PageIndex routes model names through LiteLLM, so any LiteLLM-supported
# provider works. Two separate roles are configured:
#   * index model — builds the tree + node summaries (a cheap model is fine)
#   * chat model  — answers questions over the tree (use a strong model)

# ── Default: Ollama on the same machine (offline Windows server) ─────────
# Used by `python -m superindex` (and by webapp/ and scripts/, which read the
# same variables). Nothing falls back to a cloud model: with no model set,
# superindex stops with an error that says what to set.
#
# Verified with litellm 1.97.0 + openai-agents 0.20.0 against a local Ollama:
# `ollama_chat/<model>` drives both the indexing summaries and the answering
# agent's streamed tool calls (get_document_structure / get_page_content).
# Pick a model with tool support in Ollama (qwen2.5, qwen3, llama3.1, ...);
# `ollama pull qwen2.5:7b` must have been run on the server beforehand.
PAGEINDEX_INDEX_MODEL=ollama_chat/qwen2.5:7b
PAGEINDEX_CHAT_MODEL=ollama_chat/qwen2.5:7b
PAGEINDEX_BASE_URL=http://localhost:11434
# Ollama checks no key; any placeholder works.
PAGEINDEX_API_KEY_OVERRIDE=ollama
# Leave empty for Ollama: a non-thinking model rejects reasoning_effort
# ("does not support thinking"). superindex sends none when this is unset
# or empty; webapp/server.py run on its own defaults to "low", so keep this
# line (empty) if you also use it.
PAGEINDEX_REASONING_EFFORT=
#
# Context window: Ollama's default is small (a few thousand tokens on most
# versions) and longer prompts are truncated with only a server-log warning —
# the agent's system prompt plus one document structure can exceed it. Raise
# it on the Ollama service (check `ollama ps` → CONTEXT afterwards), e.g.
#   setx OLLAMA_CONTEXT_LENGTH 32768     (Windows, then restart Ollama)
#
# Equivalent alternative, through Ollama's OpenAI-compatible endpoint (also
# verified; note the /v1 suffix):
# PAGEINDEX_INDEX_MODEL=openai/qwen2.5:7b
# PAGEINDEX_CHAT_MODEL=openai/qwen2.5:7b
# PAGEINDEX_BASE_URL=http://localhost:11434/v1
# PAGEINDEX_API_KEY_OVERRIDE=ollama

# ── Where superindex keeps its document store ──────────────────────────────
# Default: results/superindex_store in a source checkout, superindex_store/
# next to the executable in a packaged build. `--store` overrides both.
# SUPERINDEX_STORE=D:\superindex\store

# ── Keyword search (search_pages / `search`) scoring — experimental ───────
# page    (default) BM25 over whole pages.
# passage BM25 over ~300–800-character passages of each page (tables kept
#         whole, long ones cut by rows with the header repeated); a page
#         scores its best passage. Still returns whole pages. Helps when the
#         keywords sit in one small part of a long page; on our synthetic test
#         set it was not better overall, so it stays opt-in. Compare on your
#         own questions with `batch --retrieval-only --match page|passage`.
# `--match` on search / ask / serve / batch overrides this. No re-index needed.
# SUPERINDEX_BM25_MATCH=page

# ── Option: OpenAI ────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# PAGEINDEX_INDEX_MODEL=gpt-5-mini
# PAGEINDEX_CHAT_MODEL=gpt-5

# ── Option: Anthropic ─────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# PAGEINDEX_INDEX_MODEL=anthropic/claude-haiku-4-5
# PAGEINDEX_CHAT_MODEL=anthropic/claude-sonnet-4-5

# ── Option: DeepSeek ──────────────────────────────────────────────────────
# DEEPSEEK_API_KEY=sk-...
# PAGEINDEX_INDEX_MODEL=deepseek/deepseek-chat
# PAGEINDEX_CHAT_MODEL=deepseek/deepseek-reasoner
# PAGEINDEX_BASE_URL=https://api.deepseek.com

# ── Option: an intranet OpenAI-compatible gateway (Qwen, vLLM, proxy) ─────
# PAGEINDEX_BASE_URL=https://your-gateway.example.com/v1
# PAGEINDEX_API_KEY_OVERRIDE=your-gateway-key
# PAGEINDEX_INDEX_MODEL=openai/your-model-name
# PAGEINDEX_CHAT_MODEL=openai/your-model-name

# ── Latency knobs ─────────────────────────────────────────────────────────
# Reasoning effort for the chat model. Measured on this corpus: "low" cut a
# deep question from 10.3s to 5.8s (-44%) and output tokens by 62%, with the
# answer unchanged. webapp/server.py defaults to "low" when unset;
# superindex sends nothing unless it is set. Only for models that reason
# (not for the Ollama default above).
# PAGEINDEX_REASONING_EFFORT=low


# ══════════════════════════════════════════════════════════════════════════
# Azure AI Document Intelligence — PDF extraction backend
# ══════════════════════════════════════════════════════════════════════════
#
# ┌──────────────────────────────────────────────────────────────────────┐
# │ 只要下面这两项配好，Document Intelligence 就成为**默认抽取器**，      │
# │ 所有入口自动使用，不需要额外加命令行参数：                            │
# │   * scripts/02_qa_test.py   （PageIndex 建索引 + 问答）              │
# │   * nav/build.py            （两级导航建索引）                        │
# │ 没配则退回内置的 PDF 文本层（PyPDF2），行为与以前完全一致。           │
# │ python -m superindex 只读 Markdown，不在此列：先用                  │
# │ scripts/06_azure_extract.py 把 PDF 抽成 Markdown 再建库。             │
# └──────────────────────────────────────────────────────────────────────┘
#
# 为什么值得配 —— 默认的文本层路径在财报上有两个硬伤：
#   * 表格糊掉：图表页抽成 `175230`，两个数粘一起，标签与数值的关联丢失
#   * 扫描件直接拒绝：没有文本层、没有 OCR
# Azure 的 layout 模型两件都能解：表格返回真正的 Markdown 表格，
# 图片页 OCR；并且注入 `<!-- page: N -->` 标记补回页码引用。
#
# 取值来源：
#   1. Azure Portal → 创建 "Document Intelligence" 资源
#   2. 「密钥和终结点」→ 复制终结点和 KEY 1
#   3. 免费版 F0 够测试但限流很严，建议 --workers 保持 2，用 --pages 做试跑
#
# AZURE_DI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
# AZURE_DI_KEY=<your-key-1>
#
# ── 模型 ────────────────────────────────────────────────────────────────
# prebuilt-layout   表格 + 标题 + 结构   ← 财报用这个
# prebuilt-read     仅文本，最便宜
# prebuilt-document 文本 + 键值对
# AZURE_DI_MODEL=prebuilt-layout
#
# ── 输出格式 ────────────────────────────────────────────────────────────
# markdown  标题和表格保留为 Markdown   ← nav.build 需要 markdown
# text      纯文本
# AZURE_DI_OUTPUT_FORMAT=markdown
#
# ── 失败时的行为 ────────────────────────────────────────────────────────
# 默认（不设或设 0）：Azure 调用失败就**直接报错停下**。
#   这是刻意的 —— 静默退回文本层会掩盖 key 写错、终结点写错这类问题，
#   而且会让索引质量在无人察觉的情况下变化。
# 设成 1：失败时打警告并退回文本层，适合跑大批量不想中断的场景。
# AZURE_DI_FALLBACK=0
#
# ── 可选调优 ────────────────────────────────────────────────────────────
# 需要可复现输出时固定 API 版本。
# AZURE_DI_API_VERSION=2024-11-30
#
# unicodeCodePoint 让字符偏移与 Python 字符串下标对齐，页标记注入依赖这一点。
# 除非同时改 extractors/azure_di.py 里的偏移处理，否则别动。
# AZURE_DI_STRING_INDEX_TYPE=unicodeCodePoint
#
# 额外的分析特性。`formulas` 对财报有用，因为每股/比率计算常以内联公式出现。
# 其他可选：ocrHighResolution, languages, barcodes, keyValuePairs, styleFont
# AZURE_DI_FEATURES=formulas
#
# OCR 语言提示。留空让 Azure 自动识别。
# AZURE_DI_LOCALE=en-US
#
# 轮询参数。analyze 是异步的：返回 202 + Operation-Location，我们轮询到
# status 为 "succeeded" 为止。
# AZURE_DI_POLL_INTERVAL=2
# AZURE_DI_POLL_TIMEOUT=900



# ─── secrets ───────────────────────────────────────────────────────────────
# .env holds a real API key. Never commit it; use .env.example as the template.
.env

# ─── source PDFs ───────────────────────────────────────────────────────────
# Source PDFs under data/ are fetched by the download script next to them.
data/**/*.pdf

# ─── generated outputs ─────────────────────────────────────────────────────
# Everything under results/ is reproducible from the scripts. The PageIndex
# doc store and the offline trees cost a little API spend to rebuild, but they
# are build output and do not belong in git.
results/*
!results/.gitkeep
# Default store of `superindex` run from the repository root.
superindex_store/

# ─── python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ─── macOS ─────────────────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes

# ─── editors ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── misc ──────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak

.workbuddy-ai/

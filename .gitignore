# ─── secrets ───────────────────────────────────────────────────────────────
# .env holds a real API key. Never commit it; use .env.example as the template.
.env

# ─── source PDFs ───────────────────────────────────────────────────────────
# Source PDFs under data/ are fetched by the download script next to them.
data/**/*.pdf
data/*.pdf

# ─── generated outputs ─────────────────────────────────────────────────────
# Everything under results/ is reproducible from the scripts: logs and QA
# result files. Build output, does not belong in git.
results/*
!results/.gitkeep
# Default store of `superindex` run from the repository root.
superindex_store/

# ─── local development tooling ─────────────────────────────────────────────
# Local development-tooling state. Not part of the library: it stays on disk
# but out of the repository.
.workbuddy-ai/

# ─── python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ─── macOS ─────────────────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes

# ─── editors ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── misc ──────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak

.workbuddy-ai/

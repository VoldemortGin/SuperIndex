# ─── secrets ───────────────────────────────────────────────────────────────
# .env holds a real API key. Never commit it; use .env.example as the template.
.env

# ─── vendored upstream engine ──────────────────────────────────────────────
# PageIndex is vendored (not a submodule) so one clone gets a working tree.
# Only the package and the build files are kept; the bulky extras below are
# upstream's own sample material and are not needed to run anything.
# Provenance and the update procedure are in PageIndex/UPSTREAM.md.
PageIndex/.git/
PageIndex/.github/
PageIndex/examples/
PageIndex/assets/
PageIndex/cookbook/
PageIndex/tests/

# ─── source PDFs ───────────────────────────────────────────────────────────
# ~27 MB, fetched by data/aia_reports/download.sh (README §0).
data/aia_reports/*.pdf

# ─── generated outputs ─────────────────────────────────────────────────────
# Everything under results/ is reproducible from the scripts. The PageIndex
# doc store and the offline trees cost a little API spend to rebuild, but they
# are build output and do not belong in git.
results/*
!results/.gitkeep

# ─── python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ─── macOS ─────────────────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes

# ─── editors ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── misc ──────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak

# upstream editor/agent config — not needed
PageIndex/.claude/
